# =============================================================================
# Project Configuration
# =============================================================================

[project]
name = "w2t-bkin-pipeline"

[paths]
raw_root = "data/raw"
intermediate_root = "data/interim"
output_root = "data/processed"
models_root = "models"
root_metadata = "/home/user/configs/metadata.toml"  # Optional: global metadata override

# =============================================================================
# Synchronization Strategy
# =============================================================================

[synchronization]
strategy = "hardware_pulse"          # Options: rate_based | hardware_pulse | network_stream
reference_channel = "ttl_camera"      # Master clock TTL channel

[synchronization.alignment]
method = "nearest"                    # Options: nearest | linear
tolerance_s = 0.002                   # Max allowed timing jitter (seconds)
global_offset_s = 0.0                 # Global time offset correction

# =============================================================================
# Verification & Validation
# Pipeline verifies data integrity but does NOT compute timestamps (uses hardware sync)
# Session logs auto-created: {output_root}/{subject}/{session}/pipeline.log
# =============================================================================

[verification]
enabled = true                        # Master switch (disables all checks when false)
check_frame_counts = true             # Count frames via ffprobe (slow but accurate)
check_sync_mismatch = true            # Verify frame/TTL counts match (false = skip TTL checks)
skip_nwb_requirements = false         # Use FPS estimates instead of exact counts (not recommended)
mismatch_tolerance_frames = 0         # Max allowed frame/pulse difference
warn_on_mismatch = false              # Warn instead of fail when within tolerance

# =============================================================================
# Bpod Trial Synchronization
# Maps trial types to TTL channels for behavioral alignment
# =============================================================================

[[bpod.sync.trial_types]]
trial_type = 1
description = "Active whisker touch trials"
sync_signal = "W2T_Audio"             # Bpod state triggering TTL
sync_ttl = "ttl_cue"                  # TTL channel (must exist in session metadata)

[[bpod.sync.trial_types]]
trial_type = 2
description = "Passive whisker touch trials"
sync_signal = "A2L_Audio"
sync_ttl = "ttl_cue"

[[bpod.sync.trial_types]]
trial_type = 3
description = "Microstim trials"
sync_signal = "Microstim"
sync_ttl = "ttl_cue"

# =============================================================================
# Video Transcoding (Global Defaults)
# =============================================================================

[video.transcode]
enabled = true
codec = "h264"                        # ffmpeg codec
crf = 20                              # Quality: 0 (best) - 51 (worst)
preset = "fast"                       # Encoding speed preset
keyint = 15                           # GOP size (frames)

# =============================================================================
# Extracellular Electrophysiology (Neuropixels)
# =============================================================================

[ecephys]
enabled = false  # Master switch - set to true to enable ecephys processing

# List of probe device names (must match [[devices]] in metadata.toml)
# Example: ["neuropixels_imec0", "neuropixels_imec1"]
probes = []

[ecephys.storage]
# How to handle raw AP band data in NWB file
raw_data_strategy = "link"  # Options: "link" (HDF5 external link, recommended)
                             #          "copy" (embed in NWB, large files)
                             #          "skip" (don't include raw data)

# Whether to compute and store LFP data (future feature)
compute_lfp = false

[ecephys.quality]
# Filter units by cluster quality labels from Kilosort/Phy curation
# Common labels: "good" (well-isolated single units), "mua" (multi-unit activity), "noise"
include_labels = ["good", "mua"]

# Minimum spike count per unit (units below threshold are excluded)
min_spike_count = 100

# Whether to include additional data in Units table (increases file size)
add_waveforms = false         # Include mean waveforms from templates.npy
add_quality_metrics = false   # Include ContamPct, Amplitude, etc. from Kilosort

# Optional: Override brain region per probe (if not in metadata.toml)
# location_imec0 = "Motor Cortex, M1"
# location_imec1 = "Sensory Cortex, S1"

# =============================================================================
# Logging Configuration
# =============================================================================

[logging]
level = "INFO"                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
structured = false                    # Use JSON format

