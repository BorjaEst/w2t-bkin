# Docker Compose Environment Variables
# Generated automatically by w2t-bkin data init
# Edit as needed for your deployment

# =============================================================================
# Container Images
# =============================================================================
# By default, images are built locally from repository
# To use pre-built images from GitHub Container Registry, uncomment:
# SERVER_IMAGE=ghcr.io/borjaest/w2t-bkin:latest-server
# WORKER_IMAGE=ghcr.io/borjaest/w2t-bkin:latest-worker

# =============================================================================
# Data Paths (Absolute paths for volume mounts)
# =============================================================================
DATA_ROOT={{DATA_ROOT}}
MODELS_ROOT={{MODELS_ROOT}}
CONFIG_ROOT={{CONFIG_ROOT}}
OUTPUT_ROOT={{OUTPUT_ROOT}}

# =============================================================================
# Prefect Configuration
# =============================================================================
PREFECT_UI_PORT=4200
PREFECT_API_URL=http://server:4200/api

# Work pool configuration
WORK_POOL=docker-pool
WORKER_REPLICAS=1

# =============================================================================
# Resource Limits (Optional)
# =============================================================================
# Uncomment to set memory/CPU limits
# WORKER_MEMORY=8G
# WORKER_CPUS=4

# =============================================================================
# Logging
# =============================================================================
PREFECT_LOGGING_LEVEL=INFO
