# =============================================================================
# W2T-BKIN Worker Environment Configuration
# =============================================================================
# Automatically created in {project_root}/.workers/.env by 'w2t-bkin data init'
#
# This file configures infrastructure for Prefect Docker workers.
# For pipeline configuration (processing settings), edit configuration.toml instead.

# =============================================================================
# Docker Image Configuration
# =============================================================================
# Docker image used for flow execution in containers.
# IMPORTANT: This must be the RUNNER image, NOT the worker image.
#
# Options:
# - w2t-bkin:local                          # Local build (recommended for development)
# - ghcr.io/borjaest/w2t-bkin:latest        # Published release (recommended for production)
# - ghcr.io/borjaest/w2t-bkin:v1.2.3        # Specific version
W2T_DOCKER_IMAGE=ghcr.io/borjaest/w2t-bkin:latest

# =============================================================================
# Container Path Overrides (Advanced - Usually Not Needed)
# =============================================================================
# The work pool automatically mounts project directories at these container paths:
#   {project_root}/data   -> /data
#   {project_root}/models -> /models
#   {project_root}/output -> /output
#
# These environment variables can override the container paths if you have
# custom requirements, but normally you should configure paths in
# configuration.toml instead.
#
# NOTE: These overrides currently only work in legacy/local dev mode.
#       In production deployments, paths are baked into W2T_RUNTIME_CONFIG_JSON.

# W2T_RAW_ROOT=/data/raw
# W2T_INTERMEDIATE_ROOT=/data/interim
# W2T_OUTPUT_ROOT=/output
# W2T_MODELS_ROOT=/models
# W2T_ROOT_METADATA=/configs/metadata.toml

# Optional: Prefect worker configuration
# PREFECT_LOGGING_LEVEL=INFO
# PREFECT_WORKER_PREFETCH_SECONDS=10
