@echo off
REM w2t-bkin Pipeline Stop Script

echo ========================================
echo W2T-BKIN Pipeline Stop
echo ========================================
echo.

cd /d "%~dp0"

echo Stopping containers...
echo.

docker compose down

if %errorlevel% equ 0 (
echo.
echo ✓ Server stopped successfully
echo.
) else (
echo.
echo ✗ Failed to stop server
echo.
)

pause
