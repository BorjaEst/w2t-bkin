---
title: W2T Body Kinematics Pipeline Architecture (v0.0.11)
---
graph TD
    %% ============================================================================
    %% LEGEND: ✅ Implemented
    %% ============================================================================
    
    %% ============================================================================
    %% USER INTERFACES
    %% ============================================================================
    subgraph UserLayer["👤 User Interfaces"]
        direction LR
        CLI["✅ CLI<br/>Single session processing<br/>Batch processing<br/>Data management"]
        PrefectUI["✅ Prefect UI<br/>Flow monitoring<br/>Deployment triggers<br/>Real-time logs"]
        Docker["✅ Docker Compose<br/>Server + Workers<br/>PostgreSQL backend<br/>Multi-container orchestration"]
    end

    %% ============================================================================
    %% ORCHESTRATION LAYER (Prefect)
    %% ============================================================================
    subgraph Orchestration["🔷 Orchestration Layer (Prefect)"]
        direction TB
        
        subgraph Flows["✅ flows/"]
            SingleFlow["process_session_flow<br/>6-phase workflow<br/>Single session processing"]
            BatchFlow["batch_process_flow<br/>Parallel execution<br/>ThreadPoolExecutor<br/>Session discovery"]
        end
        
        subgraph Tasks["✅ tasks/"]
            DiscoveryTask["discovery_task<br/>Session/file discovery"]
            IngestionTask["ingestion_task<br/>Bpod/Pose/TTL ingestion"]
            ArtifactTask["artifact_generation_task<br/>DLC/SLEAP inference"]
            AssemblyTask["assembly_task<br/>Trial alignment"]
            FinalizationTask["finalization_task<br/>NWB write/validate"]
        end
    end

    %% ============================================================================
    %% OPERATIONS LAYER (Pure Python)
    %% ============================================================================
    subgraph Operations["🟢 Operations Layer (No Prefect Dependencies)"]
        direction TB
        
        Discovery["✅ operations/discovery<br/>discover_sessions()<br/>load_session_metadata()<br/>verify_files()"]
        
        Ingestion["✅ operations/ingestion<br/>ingest_bpod_data()<br/>ingest_pose_data()<br/>ingest_ttl_data()"]
        
        Artifacts["✅ operations/artifact_generation<br/>generate_dlc_pose()<br/>generate_sleap_pose()"]
        
        Assembly["✅ operations/assembly<br/>align_trials()<br/>build_behavior_table()"]
        
        Finalization["✅ operations/finalization<br/>write_nwb_file()<br/>validate_nwb()"]
        
        Config["✅ operations/config_loader<br/>load_config()<br/>validate_config()"]
        
        Verification["✅ operations/verification<br/>verify_sync()<br/>check_frame_counts()"]
    end

    %% ============================================================================
    %% FOUNDATION LAYER (NWB-First)
    %% ============================================================================
    subgraph Foundation["🔷 Foundation Layer (NWB-First)"]
        direction LR
        pynwb["pynwb~=3.1.0<br/>NWBFile, TimeSeries,<br/>TimeIntervals, ImageSeries"]
        ndx_pose["ndx-pose~=0.2.0<br/>PoseEstimation,<br/>Skeleton"]
        ndx_events["ndx-events~=0.4.0<br/>TTL/Hardware events"]
        ndx_behavior["ndx-structured-behavior~=0.1.0<br/>Trial structure"]
    end

    %% ============================================================================
    %% ORCHESTRATION LAYER (Prefect)
    %% Wraps High-Level logic for distributed execution
    %% ============================================================================
    subgraph Orchestration["🟣 Orchestration Layer (Prefect)"]
        direction TB
        prefect_flow["🔵 @flow run_session<br/>━━━━━<br/>Main entrypoint<br/>State management"]
        prefect_tasks["🔵 @task wrappers<br/>━━━━━<br/>Granular execution<br/>Retries & Logging"]
        
    
    %% ============================================================================
    %% DATA FLOW
    %% ============================================================================
    
    CLI --> Flows
    PrefectUI --> Flows
    Docker --> Flows
    
    Flows --> Tasks
    Tasks --> Operations
    
    Operations --> Foundation
    
    SingleFlow --> DiscoveryTask
    SingleFlow --> IngestionTask
    SingleFlow --> ArtifactTask
    SingleFlow --> AssemblyTask
    SingleFlow --> FinalizationTask
    
    BatchFlow --> SingleFlow
    
    DiscoveryTask --> Discovery
    IngestionTask --> Ingestion
    ArtifactTask --> Artifacts
    AssemblyTask --> Assembly
    FinalizationTask --> Finalization
    
    Discovery --> Config
    Ingestion --> Config
    Assembly --> Verification
    Finalization --> Config

